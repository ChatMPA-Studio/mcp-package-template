# MCP Server — Environment Variables
# Copy to .env and fill it in. Never commit .env (it is in .gitignore).
# Only variable NAMES and placeholders here: no real hosts, users, passwords,
# table names or account identifiers.

# --- Data source ------------------------------------------------------------
# Where the tools get their data: db (project database).
MCP_DATA_SOURCE=db

# --- Database (MCP_DATA_SOURCE=db) ------------------------------------------
# Individual vars...
MCP_DB_BACKEND=mysql
MCP_DB_HOST=CHANGEME
MCP_DB_PORT=3306
MCP_DB_USER=CHANGEME
MCP_DB_PASSWORD=CHANGEME
MCP_DB_NAME=CHANGEME
# ...or a single DATABASE_URL (takes precedence). Percent-encode special
# characters in the user or password (@ -> %40, # -> %23).
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# Optional TLS to the database (off by default). Set DB_SSL=true to encrypt;
# point DB_SSL_CA at your provider's CA bundle to also verify the server cert
# (strongly recommended once the DB is reachable over the public internet).
# Amazon RDS bundle:
#   curl -o /app/global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL=true
# DB_SSL_CA=/app/global-bundle.pem

# Connection pool
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# DB_POOL_MAX_CACHED=10

# --- Auth (API key per investigator) ----------------------------------------
# Off by default. When true, every request needs Authorization: Bearer <key>,
# validated against a DynamoDB table of key hashes, and the three AUTH_* below
# are required. AWS credentials come from the runtime (e.g. the ECS task role).
AUTH_ENABLED=false
# AUTH_DYNAMODB_TABLE=
# AUTH_AWS_REGION=
# AUTH_REQUIRED_SCOPE=
# AUTH_CACHE_TTL_SECONDS=60
# AUTH_CACHE_MAX_ENTRIES=1000

# --- HTTP Server ------------------------------------------------------------
PORT=8000
MCP_BASE_PATH=/mcp
LOG_LEVEL=INFO

# --- Docker Compose ---------------------------------------------------------
# HOST_PORT: the port exposed on the host (default 8001, bound to 127.0.0.1)
HOST_PORT=8001
# Container name (used by docker-compose and scripts/deploy.sh)
COMPOSE_PROJECT_NAME=my-mcp
