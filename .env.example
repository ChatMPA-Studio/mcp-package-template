# MCP Server — Environment Variables
# Copy to .env and fill in credentials.  Never commit .env to version control.

# --- Database (individual vars) ---
MCP_DB_BACKEND=mysql
MCP_DB_HOST=localhost
MCP_DB_PORT=3306
MCP_DB_USER=mcp_readonly
MCP_DB_PASSWORD=CHANGEME
MCP_DB_NAME=mydb

# --- Or use a single DATABASE_URL (takes precedence over individual vars) ---
# DATABASE_URL=mysql://mcp_readonly:PASSWORD@localhost:3306/mydb
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
# DATABASE_URL=sqlite:///path/to/db.sqlite

# --- HTTP Server (Docker) ---
PORT=8000
MCP_BASE_PATH=/mcp
LOG_LEVEL=INFO

# --- Docker Compose ---
# HOST_PORT: the port exposed on the host (default 8001, bound to 127.0.0.1)
HOST_PORT=8001

# --- Container name (used by docker-compose) ---
COMPOSE_PROJECT_NAME=my-mcp
