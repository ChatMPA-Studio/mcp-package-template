{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package.schema.json",
  "title": "MCP Package Metadata",
  "description": "Describes the MCP server package: identity, version, runtime, and maintainer.",
  "type": "object",
  "required": ["name", "version", "description"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Package identifier (kebab-case, e.g. 'my-data-mcp')."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "description": "Semantic version (e.g. '1.0.0')."
    },
    "description": {
      "type": "string",
      "description": "One-line summary of the MCP server's purpose."
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "organization": { "type": "string" }
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier (e.g. 'MIT', 'Apache-2.0')."
    },
    "repository": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["git", "svn"] },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "python_version": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "docker_image": { "type": "string" },
        "port": { "type": "integer" },
        "base_path": { "type": "string" }
      }
    }
  }
}
